                        </outerBoundaryIs>
                    </Polygon>
                </Placemark>
                <Placemark id="163">
                    <name>Sahel Belt</name>
                    <description>Sahel heat zone — 15-25% rainfall decline combined with temperature increases of 2-3°C. Agricultural viability collapsed in worst-affected zones. APPROXIMATE — Narrative-derived polygon. Replace with data-driven geometry when source dataset becomes available. See: 2050-snapshot/domains/climate.md#heatwaves</description>
                    <gx:CascadingStyle><Style><LineStyle><color>ff55b0b0</color><width>0.5</width></LineStyle><PolyStyle><color>4055b0b0</color></PolyStyle></Style></gx:CascadingStyle><Polygon id="162">
