                        <altitudeMode>clampToGround</altitudeMode>
                    </Point>
                </Placemark>
                <Placemark id="388">
                    <name>Netherlands — Coastal Defenses</name>
                    <description>Dutch Delta Works and North Sea protection — the world's most advanced sea defense system, continuously upgraded for 0.35m+ SLR. See: 2050-snapshot/domains/climate.md#to-technology</description>
