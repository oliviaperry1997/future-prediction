                        <coordinates>151.2,-33.8,0</coordinates>
                        <altitudeMode>clampToGround</altitudeMode>
                    </Point>
                </Placemark>
                <Placemark id="383">
                    <name>Singapore — Desalination</name>
                    <description>Singapore desalination and NEWater — advanced water recycling and desalination for water-independent city-state. See: 2050-snapshot/domains/climate.md#to-technology</description>
                    <gx:CascadingStyle><Style><IconStyle><color>ff55b0b0</color><scale>0.8</scale></IconStyle></Style></gx:CascadingStyle><Point id="382">
