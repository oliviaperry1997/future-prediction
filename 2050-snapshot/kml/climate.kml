                <name>Desalination and Adaptation Infrastructure</name>
                <Placemark id="358">
                    <name>Saudi Arabia — Desalination Hub</name>
                    <description>Major desalination plant cluster — Saudi Arabia's water supply is critically dependent on desalination. The world's largest desalination producer. See: 2050-snapshot/domains/climate.md#to-technology</description>
                    <gx:CascadingStyle><Style><IconStyle><color>ff55b0b0</color><scale>0.8</scale></IconStyle></Style></gx:CascadingStyle><Point id="357">
                        <coordinates>50.2,26.4,0</coordinates>
                        <altitudeMode>clampToGround</altitudeMode>
                    </Point>
                </Placemark>
                <Placemark id="363">
                    <name>Israel / APR — Desalination</name>
                    <description>Advanced desalination infrastructure — Israel/APR operates some of the world's most efficient reverse-osmosis plants, supplying ~80% of domestic water. See: 2050-snapshot/domains/climate.md#to-technology</description>
                    <gx:CascadingStyle><Style><IconStyle><color>ff55b0b0</color><scale>0.8</scale></IconStyle></Style></gx:CascadingStyle><Point id="362">
                        <coordinates>34.8,32.6,0</coordinates>
                        <altitudeMode>clampToGround</altitudeMode>
                    </Point>
                </Placemark>
                <Placemark id="368">
                    <name>UAE — Desalination</name>
                    <description>UAE desalination capacity — extensive thermal and reverse-osmosis desalination supporting urban and industrial water needs. See: 2050-snapshot/domains/climate.md#to-technology</description>
                    <gx:CascadingStyle><Style><IconStyle><color>ff55b0b0</color><scale>0.8</scale></IconStyle></Style></gx:CascadingStyle><Point id="367">
                        <coordinates>55.3,25.2,0</coordinates>
                        <altitudeMode>clampToGround</altitudeMode>
                    </Point>
                </Placemark>
                <Placemark id="373">
                    <name>California/Pacifica — Desalination</name>
                    <description>Pacifica desalination plants — drought-driven investment in coastal desalination infrastructure for Southern California. See: 2050-snapshot/domains/climate.md#to-technology</description>
                    <gx:CascadingStyle><Style><IconStyle><color>ff55b0b0</color><scale>0.8</scale></IconStyle></Style></gx:CascadingStyle><Point id="372">
                        <coordinates>-117.0,33.0,0</coordinates>
                        <altitudeMode>clampToGround</altitudeMode>
                    </Point>
                </Placemark>
                <Placemark id="378">
                    <name>Australia — Desalination</name>
                    <description>Australian desalination plants — Sydney and other major cities depend on desalination for drought security. See: 2050-snapshot/domains/climate.md#to-technology</description>
